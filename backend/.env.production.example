# Variables for a production deploy (see "Deploying" in the README). On Render these are set in
# the dashboard; render.yaml lists them. Copy to .env.production for a local record, never commit it.
NODE_ENV=production

# Behind the web app's /api proxy and the host's load balancer: the number of proxies in front.
TRUST_PROXY=1

# The web app's public URL. Browsers reach the API through it, so cookies and OAuth callbacks
# are built from it, and it is the only trusted origin for writes.
BETTER_AUTH_URL=https://your-site.example.com
TRUSTED_ORIGINS=https://your-site.example.com
BETTER_AUTH_SECRET=

# Postgres with the pgvector extension, session-mode connection string
DATABASE_URL=postgresql://user:password@host:5432/postgres

# S3-compatible storage with a private bucket
S3_ENDPOINT=https://your-storage.example.com
S3_REGION=
S3_BUCKET=codebook
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# Inngest Cloud. INNGEST_DEV must stay unset: it turns off request signing.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Model providers and tools
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GROQ_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=

# Ids of the users who may open /api/v1/monitoring and /api/v1/evals
ADMIN_USER_IDS=
