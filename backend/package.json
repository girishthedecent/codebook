{
  "name": "codebook-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:migrate:new": "prisma migrate dev --create-only",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "evals": "node --import tsx evals/runner.ts",
    "evals:corpus": "node --import tsx evals/corpus.ts",
    "evals:import": "node --import tsx evals/import.ts",
    "evals:report": "node --import tsx evals/report.ts",
    "evals:worker": "node --import tsx evals/worker.ts",
    "evals:synth": "node --import tsx evals/synth.ts",
    "evals:failures": "node --import tsx evals/failures.ts",
    "evals:calibrate": "node --import tsx evals/calibrate.ts",
    "evals:gate": "node --import tsx evals/gate.ts",
    "evals:baseline": "node --import tsx evals/baseline.ts",
    "evals:cache": "node --import tsx evals/cacheDump.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.99",
    "@ai-sdk/groq": "4.0.63",
    "@aws-sdk/client-s3": "3.1153.0",
    "@huggingface/transformers": "4.3.1",
    "@mozilla/readability": "0.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ai": "7.0.143",
    "better-auth": "1.7.12",
    "better-call": "1.4.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "htmlparser2": "10.1.0",
    "inngest": "4.24.0",
    "js-tiktoken": "1.0.21",
    "linkedom": "0.18.13",
    "multer": "2.4.0",
    "pg": "^8.23.1",
    "robots-parser": "3.0.1",
    "tar": "7.5.22",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "undici": "8.11.2",
    "unpdf": "1.9.0",
    "web-tree-sitter": "0.27.1",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inngest/test": "1.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
