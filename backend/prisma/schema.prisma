generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Auth tables follow the shape better-auth expects (regenerate with `pnpm dlx auth generate`).
model User {
  id             String          @id
  name           String
  email          String
  emailVerified  Boolean         @default(false)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  isGuest        Boolean         @default(false)
  isSystem       Boolean         @default(false)
  // Set by better-auth's anonymous plugin; a hook mirrors it into isGuest.
  isAnonymous    Boolean?        @default(false)
  sessions       Session[]
  accounts       Account[]
  workspaces     Workspace[]
  conversations  Conversation[]
  studyArtifacts StudyArtifact[]
  memories       Memory[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum WorkspaceTemplate {
  STUDY
  CODEBASE
  BLANK
}

model Workspace {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  template       WorkspaceTemplate @default(BLANK)
  isDemo         Boolean           @default(false)
  settings       Json              @default("{}")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sources        Source[]
  conversations  Conversation[]
  studyArtifacts StudyArtifact[]
  answerCache    AnswerCache[]

  @@index([userId, createdAt])
}

enum UsageType {
  LLM
  EMBEDDING
  RERANK
  WEB_SEARCH
  INGEST
}

// One row per model call. An append-only log, so no foreign keys: rows outlive the
// workspace they were spent on and cost history stays complete.
model UsageEvent {
  id           String    @id @default(cuid())
  userId       String?
  workspaceId  String?
  type         UsageType
  task         String
  provider     String
  model        String
  tokensIn     Int
  tokensOut    Int
  tokensCached Int       @default(0)
  costUsd      Decimal   @db.Decimal(12, 8)
  latencyMs    Int
  ok           Boolean
  error        String?
  fallbackUsed Boolean   @default(false)
  // The assistant message a chat call was made for, so a turn's cost can be summed.
  messageId    String?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([messageId])
}

// Read and written with raw SQL (see llm/embeddings.ts): Prisma can't map vector columns.
model EmbeddingCache {
  key       String                      @id
  embedding Unsupported("vector(1536)")
  createdAt DateTime                    @default(now())
}

enum SourceType {
  PDF
  GITHUB_REPO
  WEBSITE
}

enum SourceStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum IngestStage {
  QUEUED
  FETCHING
  FILTERING
  PARSING
  STRUCTURING
  CHUNKING
  CONTEXTUALIZING
  EMBEDDING
  INDEXING
  DONE
}

model Source {
  id             String       @id @default(cuid())
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type           SourceType
  title          String
  status         SourceStatus @default(PENDING)
  stage          IngestStage  @default(QUEUED)
  progress       Int          @default(0)
  // Last failure, safe to show the user (no secrets, no stack traces).
  error          String?
  // PDF: { storageKey, fileName, size, mime } · GITHUB_REPO: { owner, repo, ref, defaultBranch }
  // · WEBSITE: { url, maxDepth, maxPages }
  origin         Json
  stats          Json         @default("{}")
  // Same repo + ref, same URL or same PDF bytes in one workspace is a duplicate; the unique
  // index below enforces it even when two requests race.
  dedupeKey      String
  contentHash    String?
  ingestVersion  Int          @default(0)
  lastIngestedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  documents   SourceDocument[]
  tocNodes    TocNode[]
  chunks      SourceChunk[]
  ingestDraft IngestDraft?
  symbols     CodeSymbol[]
  edges       CodeEdge[]

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, createdAt])
}

// The rows below are written only by the ingestion `index` step, which replaces a source's
// documents, TOC and chunks in one transaction. Their ids come from the draft (randomUUID),
// so the inserts can link parents without reading ids back.

// One per PDF / repo file / web page: the "files" of a source.
model SourceDocument {
  id            String        @id
  sourceId      String
  source        Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  path          String
  language      String?
  // Full normalized text. PDFs: pages joined with \f, so page N is a split away.
  content       String
  pageStart     Int?
  pageEnd       Int?
  lineCount     Int?
  sizeBytes     Int
  hash          String
  skippedReason String?
  createdAt     DateTime      @default(now())
  tocNodes      TocNode[]
  chunks        SourceChunk[]
  symbols       CodeSymbol[]

  @@unique([sourceId, path])
}

model TocNode {
  id         String         @id
  sourceId   String
  source     Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  documentId String
  document   SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     TocNode?       @relation("TocTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   TocNode[]      @relation("TocTree")
  title      String
  number     String?
  level      Int
  // Reading order within the source.
  ordinal    Int
  pageStart  Int?
  pageEnd    Int?
  // The section's range in the document text, subsections included.
  charStart  Int
  charEnd    Int
  createdAt  DateTime       @default(now())

  @@index([sourceId, ordinal])
  @@index([documentId])
  @@index([parentId])
}

enum ChunkKind {
  PARENT
  CHILD
}

model SourceChunk {
  id          String                       @id
  sourceId    String
  source      Source                       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  documentId  String
  document    SourceDocument               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // Copied from the source so search can filter on it without a join.
  workspaceId String
  parentId    String?
  parent      SourceChunk?                 @relation("ChunkTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    SourceChunk[]                @relation("ChunkTree")
  symbols     CodeSymbol[]
  kind        ChunkKind
  // Order within the document, counted separately for parents and children.
  ordinal     Int
  content     String
  // Contextual-retrieval note written by the model; null when it failed or is turned off.
  context     String?
  headingPath String[]
  symbolName  String?
  pageStart   Int?
  pageEnd     Int?
  lineStart   Int?
  lineEnd     Int?
  tokenCount  Int
  hash        String
  // What keyword search indexes (tsv below) and what was embedded. Empty for parents,
  // which are read, not searched.
  searchText  String
  // CHILD chunks only. Set with raw SQL; HNSW index in the migration.
  embedding   Unsupported("vector(1536)")?
  // Generated from searchText by Postgres (see the migration); GIN index.
  tsv         Unsupported("tsvector")?
  createdAt   DateTime                     @default(now())

  @@index([workspaceId, sourceId])
  @@index([sourceId])
  @@index([documentId, kind, ordinal])
  @@index([parentId])
}

enum SymbolKind {
  FILE
  CLASS
  INTERFACE
  FUNCTION
  METHOD
}

enum EdgeType {
  IMPORTS
  DEFINES
  EXTENDS
  IMPLEMENTS
  CALLS
}

// A repository's code graph, written with its documents by the index step and removed with
// them (documentId cascade), so a resync swaps the graph in the same transaction.
model CodeSymbol {
  id            String         @id
  sourceId      String
  source        Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  documentId    String
  document      SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  name          String
  // `src/auth/service.ts#AuthService.login`; a FILE symbol's is its path.
  qualifiedName String
  kind          SymbolKind
  filePath      String
  lineStart     Int
  lineEnd       Int
  signature     String?
  exported      Boolean
  // The child chunk holding the symbol's first line, for citations.
  chunkId       String?
  chunk         SourceChunk?   @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  outgoing      CodeEdge[]     @relation("EdgeFrom")
  incoming      CodeEdge[]     @relation("EdgeTo")

  @@unique([sourceId, qualifiedName])
  @@index([sourceId, name])
  @@index([documentId])
  // Deleting chunks sets this to null; without the index each delete scans every symbol.
  @@index([chunkId])
}

model CodeEdge {
  id           String      @id @default(cuid())
  sourceId     String
  source       Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  fromSymbolId String
  from         CodeSymbol  @relation("EdgeFrom", fields: [fromSymbolId], references: [id], onDelete: Cascade)
  // Null when the target isn't in the repository (a package, a builtin) or wasn't found.
  toSymbolId   String?
  to           CodeSymbol? @relation("EdgeTo", fields: [toSymbolId], references: [id], onDelete: SetNull)
  // The target as written: `this.repo.find`, `./db`, `express`.
  toName       String
  type         EdgeType
  // Where the call, import or heritage clause is.
  filePath     String
  line         Int

  @@index([sourceId])
  @@index([fromSymbolId, type])
  @@index([toSymbolId, type])
}

// Contextual-retrieval results, so a rerun or a second copy of the same book doesn't pay
// again. Key: sha256(model | prompt id | parent hash | chunk hash).
model ContextCache {
  key       String   @id
  context   String
  createdAt DateTime @default(now())
}

// The parsed result of the ingest run in progress, so Inngest steps pass only ids and
// counts. Owned by the run that wrote it; the `index` step deletes it.
model IngestDraft {
  sourceId  String   @id
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  runId     String
  data      Json
  // A repository's code graph, kept apart from `data`: only the index step reads it.
  graph     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EvalCaseType {
  BOOK
  CODE
  MULTI_HOP
  CROSS_SOURCE
  NO_ANSWER
}

enum EvalSplit {
  DEV
  HELDOUT
}

enum EvalCaseOrigin {
  MANUAL
  SYNTHETIC
  FAILURE
}

enum EvalRunStatus {
  RUNNING
  DONE
  FAILED
}

// A golden set and the corpus it is asked against. Cases come from evals/datasets/*.json.
model EvalDataset {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  // The corpus spec the cases refer to (sourceKey → source).
  corpus      Json       @default("[]")
  createdAt   DateTime   @default(now())
  cases       EvalCase[]
  runs        EvalRun[]
}

model EvalCase {
  id             String         @id @default(cuid())
  datasetId      String
  dataset        EvalDataset    @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  // The id in the dataset file, stable across imports.
  externalId     String
  question       String
  expectedAnswer String
  // [{ sourceKey, pageStart?, pageEnd?, path?, lineStart?, lineEnd?, url?, heading? }]
  expectedRefs   Json
  type           EvalCaseType
  split          EvalSplit
  tags           String[]
  // Checked against the stored text after drafting; the report keeps the two apart.
  reviewed       Boolean        @default(false)
  // Gone from the dataset file: kept for old runs' results, never run again.
  retired        Boolean        @default(false)
  // Written by hand, generated from the corpus, or taken from a failed answer.
  origin         EvalCaseOrigin @default(MANUAL)
  // What the eval user should be remembered as before the case runs (memory configs only):
  // [{ kind, content, importance? }].
  memories       Json           @default("[]")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  results        EvalResult[]

  @@unique([datasetId, externalId])
}

model EvalRun {
  id             String        @id @default(cuid())
  datasetId      String
  dataset        EvalDataset   @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  // `retrieval` now; answers and the agent in Phase 14.
  suite          String
  // The config file's name, e.g. hybrid-rerank.
  name           String
  config         Json
  gitSha         String
  promptVersions Json          @default("[]")
  models         Json          @default("{}")
  split          EvalSplit
  status         EvalRunStatus @default(RUNNING)
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  // metric → value, overall and by type / tag / reviewed.
  summary        Json?
  costUsd        Decimal       @default(0) @db.Decimal(12, 8)
  notes          String?
  results        EvalResult[]

  @@index([suite, name, startedAt])
}

model EvalResult {
  id             String   @id @default(cuid())
  runId          String
  run            EvalRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  caseId         String
  case           EvalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  // Ranked chunk refs with their scores, and what the search reported about itself.
  retrieved      Json     @default("[]")
  answer         String?
  citations      Json?
  toolTrajectory Json?
  scores         Json     @default("{}")
  latencyMs      Int
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  costUsd        Decimal  @default(0) @db.Decimal(12, 8)
  error          String?
  createdAt      DateTime @default(now())

  @@unique([runId, caseId])
  @@index([caseId])
}

// A demo answer kept for repeat questions, so the same first question to the demo workspace
// within the TTL is answered without model calls. The key is a hash of what the answer
// depends on: workspace, normalized question, prompt and the sources' ingest state.
model AnswerCache {
  key         String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  content     String
  // The checked citations, as the turn saved them.
  citations   Json
  model       String?
  promptId    String
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

// A judge's verdict, keyed by judge prompt, judge model, case and answer hash, so a rerun of
// the same answer never pays for the same judgement twice.
model EvalJudgeCache {
  key       String   @id
  // The prompt id and model, e.g. judge-grounding@v1 groq/openai/gpt-oss-120b.
  judge     String
  value     Json
  createdAt DateTime @default(now())
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageStatus {
  COMPLETE
  ERROR
  ABORTED
}

enum Feedback {
  UP
  DOWN
}

model Conversation {
  id                      String    @id @default(cuid())
  workspaceId             String
  workspace               Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                   String
  // Rolling summary of the messages up to summarizedUpToMessageId, so older turns still
  // reach the model once they fall out of the verbatim history.
  summary                 String?
  summarizedUpToMessageId String?
  // Memory extraction has read the messages up to this one; it only learns from later ones.
  memoryUpToMessageId     String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  messages                Message[]

  @@index([workspaceId, updatedAt])
  @@index([userId])
}

model Message {
  id               String        @id @default(cuid())
  conversationId   String
  conversation     Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             MessageRole
  content          String
  // Assistant turns: [{ n, valid, supported, ...ref }] and [{ step, tool, args, summary, ms }].
  citations        Json          @default("[]")
  toolCalls        Json          @default("[]")
  model            String?
  promptVersion    String?
  tokensIn         Int           @default(0)
  tokensOut        Int           @default(0)
  tokensCached     Int           @default(0)
  costUsd          Decimal       @default(0) @db.Decimal(12, 8)
  latencyMs        Int?
  firstTokenMs     Int?
  retrievalMs      Int?
  // Quality signals for monitoring: citations that pointed nowhere, and a search that
  // found nothing good.
  invalidCitations Int           @default(0)
  weakRetrieval    Boolean       @default(false)
  status           MessageStatus @default(COMPLETE)
  error            String?
  feedback         Feedback?
  feedbackNote     String?
  // Assistant turns asked not to use memory: nothing is learned from them either.
  memoryOff        Boolean       @default(false)
  createdAt        DateTime      @default(now())
  memories         Memory[]

  @@index([conversationId, createdAt])
  @@index([createdAt])
}

enum MemoryKind {
  PROFILE
  FACT
}

// What CodeBook remembers about a user, across workspaces. The embedding is set with raw
// SQL and searched exactly per user (no vector index, see the migration); deleted rows stay
// until the user clears them for good.
model Memory {
  id              String                       @id @default(cuid())
  userId          String
  user            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            MemoryKind
  // One fact or profile line.
  content         String
  embedding       Unsupported("vector(1536)")?
  // The answer whose turn it was learned from; null when added by hand.
  sourceMessageId String?
  sourceMessage   Message?                     @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  // 1 (trivia) to 5 (shapes every answer).
  importance      Int                          @default(3)
  lastUsedAt      DateTime?
  deletedAt       DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@index([userId, kind, deletedAt])
  @@index([sourceMessageId])
}

enum StudyType {
  QUIZ
  FLASHCARDS
  MINDMAP
  SUMMARY
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model StudyArtifact {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          StudyType
  title         String
  // { sourceIds, tocNodeId?, pathPrefix?, topic?, count?, difficulty? }
  input         Json
  status        JobStatus @default(PENDING)
  // Typed per type by study.schemas.ts; citations resolved from `sources`.
  data          Json?
  sources       Json      @default("[]")
  error         String?
  model         String?
  promptVersion String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId, createdAt])
}

// Fixed-window rate limit counters, one row per key and window.
model RateLimitHit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}
