generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Auth tables follow the shape better-auth expects (regenerate with `pnpm dlx auth generate`).
model User {
  id            String      @id
  name          String
  email         String
  emailVerified Boolean     @default(false)
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  isGuest       Boolean     @default(false)
  isSystem      Boolean     @default(false)
  sessions      Session[]
  accounts      Account[]
  workspaces    Workspace[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum WorkspaceTemplate {
  STUDY
  CODEBASE
  BLANK
}

model Workspace {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  template    WorkspaceTemplate @default(BLANK)
  isDemo      Boolean           @default(false)
  settings    Json              @default("{}")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  sources     Source[]

  @@index([userId, createdAt])
}

enum UsageType {
  LLM
  EMBEDDING
  RERANK
  WEB_SEARCH
  INGEST
}

// One row per model call. An append-only log, so no foreign keys: rows outlive the
// workspace they were spent on and cost history stays complete.
model UsageEvent {
  id           String    @id @default(cuid())
  userId       String?
  workspaceId  String?
  type         UsageType
  task         String
  provider     String
  model        String
  tokensIn     Int
  tokensOut    Int
  tokensCached Int       @default(0)
  costUsd      Decimal   @db.Decimal(12, 8)
  latencyMs    Int
  ok           Boolean
  error        String?
  fallbackUsed Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

// Read and written with raw SQL (see llm/embeddings.ts): Prisma can't map vector columns.
model EmbeddingCache {
  key       String                      @id
  embedding Unsupported("vector(1536)")
  createdAt DateTime                    @default(now())
}

enum SourceType {
  PDF
  GITHUB_REPO
  WEBSITE
}

enum SourceStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum IngestStage {
  QUEUED
  FETCHING
  FILTERING
  PARSING
  STRUCTURING
  CHUNKING
  CONTEXTUALIZING
  EMBEDDING
  INDEXING
  DONE
}

model Source {
  id             String       @id @default(cuid())
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type           SourceType
  title          String
  status         SourceStatus @default(PENDING)
  stage          IngestStage  @default(QUEUED)
  progress       Int          @default(0)
  // Last failure, safe to show the user (no secrets, no stack traces).
  error          String?
  // PDF: { storageKey, fileName, size, mime } · GITHUB_REPO: { owner, repo, ref, defaultBranch }
  // · WEBSITE: { url, maxDepth, maxPages }
  origin         Json
  stats          Json         @default("{}")
  // Same repo + ref, same URL or same PDF bytes in one workspace is a duplicate; the unique
  // index below enforces it even when two requests race.
  dedupeKey      String
  contentHash    String?
  ingestVersion  Int          @default(0)
  lastIngestedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, createdAt])
}
