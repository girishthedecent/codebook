@base = http://localhost:4000
@origin = http://localhost:4000

### Sign in first (REST Client keeps the session cookie)
POST {{base}}/api/auth/sign-in/email
Content-Type: application/json
Origin: {{origin}}

{ "email": "reader@example.com", "password": "correct-horse-battery" }

### A workspace to add sources to
# @name workspace
POST {{base}}/api/v1/workspaces
Content-Type: application/json
Origin: {{origin}}

{ "name": "Sources demo" }

###
@workspaceId = {{workspace.response.body.data.id}}

### Upload a PDF (any PDF up to 50 MB; point the path at one on your disk)
# @name pdf
POST {{base}}/api/v1/workspaces/{{workspaceId}}/sources
Origin: {{origin}}
Content-Type: multipart/form-data; boundary=CodeBookBoundary

--CodeBookBoundary
Content-Disposition: form-data; name="title"

My book
--CodeBookBoundary
Content-Disposition: form-data; name="file"; filename="book.pdf"
Content-Type: application/pdf

< ./book.pdf
--CodeBookBoundary--

###
@sourceId = {{pdf.response.body.data.id}}

### Add a public GitHub repo (default branch, or /tree/{ref} in the URL, or "ref")
POST {{base}}/api/v1/workspaces/{{workspaceId}}/sources
Content-Type: application/json
Origin: {{origin}}

{ "type": "GITHUB_REPO", "url": "https://github.com/expressjs/express" }

### Add a website (maxDepth 0–2, maxPages 1–50)
POST {{base}}/api/v1/workspaces/{{workspaceId}}/sources
Content-Type: application/json
Origin: {{origin}}

{ "type": "WEBSITE", "url": "https://expressjs.com/en/guide/routing.html", "maxDepth": 0 }

### List the workspace's sources
GET {{base}}/api/v1/workspaces/{{workspaceId}}/sources

### Workspace with source counts by status
GET {{base}}/api/v1/workspaces/{{workspaceId}}

### One source
GET {{base}}/api/v1/sources/{{sourceId}}

### Progress stream (Server-Sent Events; ends after `done` or `failed`)
GET {{base}}/api/v1/sources/{{sourceId}}/events

### Table of contents (a tree; empty before the first ingest)
# @name toc
GET {{base}}/api/v1/sources/{{sourceId}}/toc

@tocNodeId = {{toc.response.body.$.data[0].id}}

### Files of the source (one per PDF; a repository's files in path order, skipped ones with
### their reason; page on with ?cursor=<nextCursor>)
GET {{base}}/api/v1/sources/{{sourceId}}/files

### Repository files under a folder
GET {{base}}/api/v1/sources/{{sourceId}}/files?prefix=lib/&limit=50

### Text of one PDF page (physical page number, 1 = first page of the file)
GET {{base}}/api/v1/sources/{{sourceId}}/content?page=24

### Text of a TOC section, subsections included (the first chapter from the toc request)
GET {{base}}/api/v1/sources/{{sourceId}}/content?tocNodeId={{tocNodeId}}

### Lines of a repository file (1-based, inclusive; at most 400 per request)
GET {{base}}/api/v1/sources/{{sourceId}}/content?path=lib/response.js&lineStart=1&lineEnd=40

### Resync (409 while queued or processing)
POST {{base}}/api/v1/sources/{{sourceId}}/resync
Origin: {{origin}}

### Delete (stored files are removed in the background)
DELETE {{base}}/api/v1/sources/{{sourceId}}
Origin: {{origin}}
