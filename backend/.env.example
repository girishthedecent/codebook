# app
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
LOG_LEVEL=debug
LOG_TO_FILE=true
# behind a load balancer: hop count or proxy IPs (true is refused in production)
TRUST_PROXY=false

# database
DATABASE_URL=postgresql://codebook:codebook@localhost:5436/codebook
TEST_DATABASE_URL=postgresql://codebook:codebook@localhost:5436/codebook_test

# auth (better-auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TRUSTED_ORIGINS=http://localhost:3000

# github api (repo downloads)
GITHUB_TOKEN=

# storage (minio in dev)
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=codebook
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# inngest (dev mode talks to the local dev server without keys; production needs both
# keys and must not set INNGEST_DEV, which turns off request signing)
INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# eval worker (pnpm evals:worker) runs eval suites queued by POST /api/v1/evals/runs
EVALS_WORKER_PORT=4001

# monitoring: comma-separated user ids allowed to read /api/v1/monitoring
ADMIN_USER_IDS=

# llm providers
GROQ_API_KEY=
GEMINI_API_KEY=

# search
TAVILY_API_KEY=

# reranker
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANKER_CACHE_DIR=.cache/models

# feature toggles
LIVE_TESTS=0
