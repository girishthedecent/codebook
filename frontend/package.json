{
  "name": "codebook-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc -b && vite build && node --import tsx scripts/prerender.ts",
    "preview": "vite preview --port 3000",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "gen:api": "node --import tsx scripts/gen-api.ts",
    "size": "size-limit && node --import tsx scripts/initial-size.ts",
    "lhci": "lhci autorun",
    "lhci:mobile": "lhci autorun --config=lighthouserc.mobile.json"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-virtual": "3.14.15",
    "@xyflow/react": "12.12.0",
    "better-auth": "1.7.7",
    "cmdk": "1.1.1",
    "eventsource-parser": "4.1.1",
    "openapi-fetch": "0.17.0",
    "pdfjs-dist": "6.4.299",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.4",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "vaul": "1.1.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@size-limit/file": "14.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.43",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "size-limit": "14.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
